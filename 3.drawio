        <mxCell id="mL_DVJK156abVaetZoNF-627" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 30px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;1.ctp_resource中类型= page的资源先转换成授权对象&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;2.外框、子页面等转换成授权对象&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;3.菜单根据page的路径反算和授权对象绑定关系&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;4.底导航、控件根据path反算找到对应的page，作为其的权限项&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;5.角色资源的关系&amp;nbsp; &amp;nbsp;-》生成角色、授权对象、权限项的关系&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;6.原已授权资源 根据类型拆分成两张表（挂在角色上的资源和没通过角色授权的资源）&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="450" width="1500" x="4060" y="4930" as="geometry" />
        </mxCell>
        <mxCell id="mL_DVJK156abVaetZoNF-629" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;SET NAMES utf8mb4;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;SET FOREIGN_KEY_CHECKS = 0;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;-- ----------------------------&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;-- 1. 数据规则与角色关联&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;-- ----------------------------&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;DROP TABLE IF EXISTS `ctp_data_permission_func`;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;CREATE TABLE `ctp_data_permission_func`&amp;nbsp; (&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `id` bigint NOT NULL COMMENT &#39;主键ID&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `tenant_id` bigint NOT NULL COMMENT &#39;租户ID&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `data_permission_id` bigint NOT NULL COMMENT &#39;数据规则ID&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `role_id` bigint NOT NULL COMMENT &#39;角色ID&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `status` tinyint NOT NULL DEFAULT 1 COMMENT &#39;状态：0-禁用 1-启用&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `is_delete` tinyint NOT NULL DEFAULT 0 COMMENT &#39;是否删除：0-未删除 1-已删除&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `create_user` bigint NOT NULL COMMENT &#39;创建人&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `update_user` bigint NOT NULL COMMENT &#39;更新人&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `create_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT &#39;创建时间&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `update_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT &#39;更新时间&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `version` smallint NOT NULL DEFAULT 0 COMMENT &#39;乐观锁版本号&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; PRIMARY KEY (`id`) USING BTREE,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; KEY `idx_data_role_permission` (`role_id`,`data_permission_id`) USING BTREE COMMENT &#39;数据规则+角色索引&#39;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;) ENGINE = InnoDB CHARACTER SET = utf8mb4 COLLATE = utf8mb4_unicode_ci ROW_FORMAT = DYNAMIC COMMENT = &#39;数据规则与角色关联关系表&#39;;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;-- ----------------------------&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;-- 2. 数据规则授权表&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;-- ----------------------------&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;DROP TABLE IF EXISTS `ctp_data_permission_auth`;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;CREATE TABLE `ctp_data_permission_auth`&amp;nbsp; (&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `id` bigint NOT NULL COMMENT &#39;主键ID&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `tenant_id` bigint NOT NULL COMMENT &#39;租户ID&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `data_permission_id` bigint NOT NULL COMMENT &#39;数据规则ID&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `entity_id` bigint NOT NULL COMMENT &#39;授权对象ID&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `entity_type` tinyint NOT NULL COMMENT &#39;授权对象类型&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `org_scope` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT &#39;主控范围&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `status` tinyint NOT NULL DEFAULT 1 COMMENT &#39;状态：0-禁用 1-启用&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `is_delete` tinyint NOT NULL DEFAULT 0 COMMENT &#39;是否删除：0-未删除 1-已删除&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `create_user` bigint NOT NULL COMMENT &#39;创建人&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `update_user` bigint NOT NULL COMMENT &#39;更新人&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `create_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT &#39;创建时间&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `update_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT &#39;更新时间&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `version` smallint NOT NULL DEFAULT 0 COMMENT &#39;乐观锁版本号&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; PRIMARY KEY (`id`) USING BTREE,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; KEY `idx_data_entity` (`data_permission_id`,`entity_id`) USING BTREE COMMENT &#39;数据规则+授权对象索引&#39;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;) ENGINE = InnoDB CHARACTER SET = utf8mb4 COLLATE = utf8mb4_unicode_ci ROW_FORMAT = DYNAMIC COMMENT = &#39;数据规则授权表&#39;;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;-- ----------------------------&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;-- 3. 角色-授权对象-权限项绑定&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;-- ----------------------------&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;DROP TABLE IF EXISTS `ctp_role_permission_object_item`;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;CREATE TABLE `ctp_role_permission_object_item`&amp;nbsp; (&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `id` bigint NOT NULL COMMENT &#39;主键ID&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `tenant_id` bigint NOT NULL COMMENT &#39;租户ID&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `app_id` bigint NOT NULL COMMENT &#39;应用id&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `role_id` bigint NOT NULL COMMENT &#39;角色id&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `permission_object_id` bigint NOT NULL COMMENT &#39;授权对象id&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `permission_item_id` bigint NOT NULL COMMENT &#39;权限项id&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `status` tinyint NOT NULL DEFAULT 1 COMMENT &#39;状态：0-禁用 1-启用&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `is_delete` tinyint NOT NULL DEFAULT 0 COMMENT &#39;是否删除：0-未删除 1-已删除&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `create_user` bigint NOT NULL COMMENT &#39;创建人&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `update_user` bigint NOT NULL COMMENT &#39;更新人&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `create_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT &#39;创建时间&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `update_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT &#39;更新时间&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `version` smallint NOT NULL DEFAULT 0 COMMENT &#39;乐观锁版本号&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; PRIMARY KEY (`id`) USING BTREE,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; KEY `idx_role_object_item` (`role_id`,`permission_object_id`,`permission_item_id`) USING BTREE COMMENT &#39;角色+对象+权限项索引&#39;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;) ENGINE = InnoDB CHARACTER SET = utf8mb4 COLLATE = utf8mb4_unicode_ci ROW_FORMAT = DYNAMIC COMMENT = &#39;角色、授权对象、权限项绑定关系表&#39;;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;-- ----------------------------&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;-- 4. 授权对象分类&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;-- ----------------------------&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;DROP TABLE IF EXISTS `ctp_permission_object_category`;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;CREATE TABLE `ctp_permission_object_category`&amp;nbsp; (&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `id` bigint NOT NULL COMMENT &#39;主键ID&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `tenant_id` bigint NOT NULL COMMENT &#39;租户ID&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `category_name` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT &#39;分类名称&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `category_code` varchar(100) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT &#39;分类编码&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `app_id` bigint NOT NULL COMMENT &#39;应用id&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `status` tinyint NOT NULL DEFAULT 1 COMMENT &#39;状态：0-禁用 1-启用&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `is_delete` tinyint NOT NULL DEFAULT 0 COMMENT &#39;是否删除：0-未删除 1-已删除&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `create_user` bigint NOT NULL COMMENT &#39;创建人&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&amp;nbsp; `update_user` bigint NOT NULL COMMENT &#39;更新人&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px